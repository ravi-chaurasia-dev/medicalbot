APP_NAME="MediAI"
APP_ENV="development"
APP_DEBUG="true"
APP_URL="http://localhost:8000"
APP_TIMEZONE="UTC"

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="mediai"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"

MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_NAME="MediAI"
MAIL_FROM_ADDRESS="noreply@example.com"

SESSION_NAME="mediai_session"
SESSION_LIFETIME="120"
CSRF_SECRET="change-this-to-a-long-random-secret-value"

LOG_CHANNEL="file"
LOG_PATH="storage/logs/app.log"
