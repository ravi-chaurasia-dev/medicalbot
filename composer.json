{
    "name": "medi-ai/medicalbot",
    "description": "MediAI - AI Healthcare Assistant foundation architecture",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "MediAI Team",
            "email": "team@mediai.local"
        }
    ],
    "require": {
        "php": "^8.3",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 1200
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"if (!file_exists('.env')) { copy('.env.example', '.env'); }\""
        ]
    }
}
